#!/usr/bin/env python3
"""
otdr_studio.py — integrated OTDR trend viewer / annotator.

Sits on top of otdr_common.py, otdr_trends.py, otdr_channel.py (keep them beside this).

Features
--------
* Load a folder of CSVs, navigate Prev/Next, filter.
* Smoothing: None / Moving average / Savitzky-Golay / Median / Gaussian + window.
* Pluggable trend DETECTORS (registry): "Regression Channel", "Piecewise Linear",
  plus "Load custom model…" — any .py exposing
      detect(km, db, db_s, ignore_zones_m, params) -> result dict
* Ignore zones: drag on the plot to exclude a span from the trend fit (launch
  dead-zone, bad sections). Listed + removable.
* Annotation / mask tool: click to drop labelled points (segment boundary, bend,
  break, connector). Export per-file JSON masks for ML training of the trends.
* Zoom / pan via the Matplotlib toolbar; "Fit valid region" button.

Install:  pip install PyQt5 matplotlib numpy scipy
Run:      python otdr_studio.py
"""

import os, sys, glob, json, importlib.util
import numpy as np

from scipy.signal import savgol_filter, medfilt, find_peaks
from scipy.ndimage import gaussian_filter1d
from scipy.stats import theilslopes

